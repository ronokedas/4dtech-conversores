# Documentos Online - 4D Tech
# Copie este arquivo para .env e altere conforme o ambiente.
#
# Local no Windows:
#   SITE_ADDRESS=http://localhost
#   PUBLIC_ORIGIN=http://localhost:8090
#   HOST_PORT=8090
#
# Produção na VPS com o domínio principal e Cloudflare:
#   SITE_ADDRESS=www.4dtech.com.br
#   REDIRECT_SITE_ADDRESS=4dtech.com.br
#   PUBLIC_ORIGIN=https://www.4dtech.com.br
#   HOST_PORT=80
#   HTTPS_PORT=443
#   HTTPS_UDP_PORT=443

# Endereço local: http://localhost:8090
SITE_ADDRESS=http://localhost
REDIRECT_SITE_ADDRESS=http://redirect.invalid
PUBLIC_ORIGIN=http://localhost:8090
HOST_PORT=8090
HTTPS_PORT=8443
HTTPS_UDP_PORT=8443

# Comunicação interna dos containers.
# Em geral, não altere.
API_INTERNAL_ORIGIN=http://api:4000
REDIS_URL=redis://redis:6379
JOB_DIR=/data/jobs

# Limpeza e limites gerais.
JOB_TTL_SECONDS=3600
MAX_UPLOAD_MB=25
MAX_EXTRACTED_MB=100
MAX_ZIP_FILES=500
MAX_PDF_MB=50
CONVERSION_TIMEOUT_MS=45000

# Imagem, áudio e vídeo.
MAX_IMAGE_UPLOAD_MB=15
MAX_AUDIO_UPLOAD_MB=50
MAX_VIDEO_UPLOAD_MB=100
IMAGE_TIMEOUT_MS=60000
AUDIO_TIMEOUT_MS=900000
MEDIA_TIMEOUT_MS=180000

# Modelo recomendado para VPS 2 vCPU / 4 GB RAM.
WHISPER_MODEL=tiny
WORKER_CONCURRENCY=2

# Limites liberais para uso público inicial.
RATE_LIMIT_10_MINUTES=300
RATE_LIMIT_HOUR=2000

# Cloudflare Turnstile.
# Deixe vazio no desenvolvimento local.
# Em produção, use:
# TURNSTILE_SITE_KEY = Site key do widget
# NEXT_PUBLIC_TURNSTILE_SITE_KEY = mesmo valor da Site key
# TURNSTILE_SECRET_KEY = Secret key do widget
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_API_BASE=/api

# AdSense e Analytics.
# Ative somente depois da aprovação do site no AdSense.
# NEXT_PUBLIC_ADSENSE_CLIENT exemplo: ca-pub-1234567890123456
# Os slots vêm dos blocos de anúncio criados no AdSense.
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_HOME_SLOT=
NEXT_PUBLIC_ADSENSE_DOWNLOAD_SLOT=
NEXT_PUBLIC_GA_ID=

# Produção: seu e-mail para certificados automáticos do Caddy/Let's Encrypt.
ACME_EMAIL=
